{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.html",
    "build": "rm -rf dist && bun build index.html --outdir dist/assets --minify --public-path /assets/ --entry-naming '[name]-[hash].[ext]' --define 'process.env.NODE_ENV=\"production\"' && mv dist/assets/*.html dist/index.html",
    "lint": "bun --bun eslint .",
    "preview": "cd dist && bun --port=4173 ./index.html"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "react-spreadsheet": "^0.10.1",
    "wordcloud": "^1.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
